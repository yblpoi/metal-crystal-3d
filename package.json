{
  "name": "metal-crystal-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive 3D visualization of FCC / BCC / HCP metal crystals with hard-sphere atoms and interstitial sites",
  "license": "AGPL-3.0-only",
  "author": "yblpoi",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "visual": "node scripts/visual-check.mjs",
    "test:export": "node scripts/export-check.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "gifenc": "^1.0.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.11",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
